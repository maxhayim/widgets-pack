{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.0.0/resources/zpack-schema.json",
  "name": "widgets-pack",
  "version": "1.4.1",
  "description": "Thirteen Braun-inspired desktop widgets: clock, weather, radio, calendar, world clock, stocks, sticky notes, convert, calculator, mesh, flight tracker, translator, and photo gallery.",
  "tags": [
    "widgets",
    "clock",
    "weather",
    "radio",
    "calendar",
    "braun"
  ],
  "previewImages": [
    "./docs/assets/screenshot.png"
  ],
  "repositoryUrl": "https://github.com/maxhayim/widgets-pack",
  "widgets": [
    {
      "name": "clock",
      "htmlPath": "./dist/clock/index.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "dist/**"
      ],
      "caching": {
        "defaultDuration": 0,
        "rules": [
          {
            "urlRegex": "^https://fonts\\.(googleapis|gstatic)\\.com/",
            "duration": 604800
          }
        ]
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "open",
            "argsRegex": "^https://[^\\s\"']+$"
          },
          {
            "program": "xdg-open",
            "argsRegex": "^https://[^\\s\"']+$"
          },
          {
            "program": "explorer",
            "argsRegex": "^https://[^\\s\"']+$"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_right",
          "offsetX": "-16px",
          "offsetY": "48px",
          "width": "220px",
          "height": "220px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
